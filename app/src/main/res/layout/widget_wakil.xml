<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/w_robot"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/widget_robot_cd"
        android:scaleType="fitCenter"
        android:src="@drawable/wakil_robot_head" />

    <LinearLayout
        android:id="@+id/w_ask"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/w_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_hint"
            android:textColor="#E8F4FF"
            android:textSize="15sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_mic"
        android:contentDescription="@string/widget_mic_cd"
        android:padding="10dp"
        android:src="@android:drawable/ic_btn_speak_now" />
</LinearLayout>
